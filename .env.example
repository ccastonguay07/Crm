# Slack — create app at https://api.slack.com/apps
# Required OAuth scopes: chat:write, im:history, im:read, im:write
# Enable Socket Mode and generate an App-Level Token with scope: connections:write
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-level-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here

# Anthropic — get key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Application
DATABASE_URL=sqlite:///./crm.db
SECRET_KEY=change-me-to-a-random-secret
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true
WEB_BASE_URL=http://localhost:8000
